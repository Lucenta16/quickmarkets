{
  "name": "quickmarkets",
  "version": "1.0.0",
  "description": "Desktop screensaver application that displays real-time financial market data",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build-win": "node build-installer.js"
  },
  "build": {
    "appId": "com.quickmarkets.app",
    "productName": "QuickMarkets",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [
    "electron",
    "finance",
    "stocks",
    "cryptocurrency",
    "forex",
    "screensaver"
  ],
  "author": "QuickMarkets",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.11.0",
    "chart.js": "^4.5.0",
    "electron-store": "^10.1.0"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  }
}

{
  "name": "quickmarkets",
  "version": "1.0.0",
  "description": "Desktop screensaver application that displays real-time financial market data",
  "main": "src/main.js",
  "scripts": {
    "start": "electron . /s",
    "config": "electron . /c",
    "preview": "electron . /p",
    "dev": "NODE_ENV=development electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build-win": "node build-installer.js",
    "create-screensaver": "node create-screensaver.js"
  },
  "build": {
    "appId": "com.quickmarkets.app",
    "productName": "QuickMarkets",
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "QuickMarkets-${version}.exe"
    },
    "portable": {
      "artifactName": "QuickMarkets-Portable-${version}.exe"
    },
    "files": [
      "**/*",
      "!**/*.{dylib}"
    ],
    "asar": true
  },
  "keywords": [
    "electron",
    "finance",
    "stocks",
    "cryptocurrency",
    "forex",
    "screensaver"
  ],
  "author": "QuickMarkets",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.11.0",
    "chart.js": "^4.5.0",
    "electron-store": "^10.1.0"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  }
}
